{
  // Review and replace placeholders before any explicit remote deployment.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skiurlaub",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://replace-worker.replace-subdomain.workers.dev",
    "GOOGLE_CLIENT_ID": "replace-with-public-web-client-id.apps.googleusercontent.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-before-deployment",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // AUTH_HMAC_SECRET and ALLOWED_EMAILS: private Worker secrets, never VITE variables.
  // Google sign-in needs no mail binding. Android UI is packaged in the APK.
  // Skiline identity verification remains disabled in this phase.
}
